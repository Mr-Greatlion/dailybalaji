# ---------- Database (Neon Postgres via Vercel) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------- Auth ----------
# Any long random string (32+ chars). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://dailybalaji.com"
NEXT_PUBLIC_SITE_NAME="Daily Balaji"

# ---------- Admin bootstrap (used by prisma seed only) ----------
ADMIN_EMAIL="admin@dailybalaji.com"
ADMIN_PASSWORD="ChangeMe@123"

# ---------- Razorpay ----------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"

# ---------- Email (Gmail SMTP - use an App Password, no spaces) ----------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="xxxxxxxxxxxxxxxx"
SMTP_FROM="Daily Balaji <yourgmail@gmail.com>"
ADMIN_NOTIFY_EMAIL="yourgmail@gmail.com"

# ---------- Vercel Blob (auto-added when you connect Blob store in Vercel) ----------
BLOB_READ_WRITE_TOKEN=""
